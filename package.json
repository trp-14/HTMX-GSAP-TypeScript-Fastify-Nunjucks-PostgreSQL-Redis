{
  "name": "flowdesk",
  "version": "1.0.0",
  "private": true,
  "description": "FlowDesk \u2014 business operations & workflow management platform built with Fastify, Nunjucks, HTMX, GSAP, PostgreSQL and Redis.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:server": "tsc -p tsconfig.build.json",
    "build:client": "node scripts/build-client.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx src/db/cli/migrate.ts",
    "db:seed": "tsx src/db/cli/seed.ts",
    "db:reset": "tsx src/db/cli/migrate.ts --reset && tsx src/db/cli/seed.ts",
    "db:migrate:prod": "node dist/db/cli/migrate.js",
    "db:seed:prod": "node dist/db/cli/seed.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.5",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "gsap": "^3.12.7",
    "htmx.org": "^2.0.4",
    "ioredis": "^5.11.1",
    "nunjucks": "^3.2.4",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
