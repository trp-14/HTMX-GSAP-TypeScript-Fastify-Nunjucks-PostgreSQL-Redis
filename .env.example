# ---- Runtime ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Public origin used for CSRF origin checks and absolute links.
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ---- PostgreSQL (source of truth) ----
DATABASE_URL=postgres://flowdesk:flowdesk@localhost:5432/flowdesk

# ---- Redis (sessions, pub/sub, cache, rate limits) ----
REDIS_URL=redis://localhost:6379

# ---- Sessions ----
# Idle timeout (sliding) and absolute lifetime, in seconds.
SESSION_IDLE_TTL_SECONDS=28800
SESSION_ABSOLUTE_TTL_SECONDS=604800
# Set to true behind HTTPS so cookies get the Secure flag.
COOKIE_SECURE=false

# ---- Uploads ----
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_BYTES=10485760

# ---- Demo ----
# Password assigned to every seeded account (local development only).
SEED_PASSWORD=FlowDesk!2026
