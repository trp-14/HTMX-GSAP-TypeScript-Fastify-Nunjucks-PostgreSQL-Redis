{% extends "layouts/app.njk" %}
{% block title %}Edit {{ product.name }}{% endblock %}
{% block page %}product-form{% endblock %}
{% block crumbs %}<a href="/products">Products</a><span>/</span><a href="/products/{{ product.id }}">{{ product.sku }}</a><span>/</span><strong>Edit</strong>{% endblock %}
{% block content %}
<header class="page-head"><div><span class="eyebrow">{{ product.sku }}</span><h1 data-split>Edit product</h1><p>Stock changes are recorded as inventory movements on the product page, not here.</p></div></header>
<form class="card glass" action="/products/{{ product.id }}" hx-put="/products/{{ product.id }}" hx-target="body" novalidate data-reveal="card">
  {% include "partials/products/form.njk" %}
  <div class="form-actions"><a class="btn btn-text" href="/products/{{ product.id }}">Cancel</a><button class="btn btn-primary" type="submit">Save changes<span class="spinner" aria-hidden="true"></span></button></div>
</form>
{% endblock %}
