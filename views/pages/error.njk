{% extends "layouts/app.njk" if user else "layouts/public.njk" %}
{% block title %}{{ title }}{% endblock %}
{% block content %}
<section class="error-page"><div class="grid" style="justify-items:center;gap:14px">
  <span class="code">{{ status }}</span>
  <h1>{{ title }}</h1>
  <p class="muted" style="max-width:48ch">{{ message }}</p>
  <a class="btn btn-primary" href="{{ '/overview' if user else '/' }}">Go to {{ 'overview' if user else 'home' }}</a>
</div></section>
{% endblock %}
