{% extends "layouts/app.njk" %}
{% from "components/icons.njk" import icon %}
{% block title %}Notifications{% endblock %}
{% block page %}notifications{% endblock %}
{% block crumbs %}<strong>Notifications</strong>{% endblock %}
{% block content %}
<header class="page-head">
  <div><span class="eyebrow">Inbox</span><h1 data-split>Notifications</h1><p>Stored in PostgreSQL, delivered instantly through Redis Pub/Sub and Server-Sent Events.</p></div>
  <div class="actions">
    <div class="segmented" role="group" aria-label="Filter">
      <a href="/notifications" hx-get="/notifications" hx-target="#notification-results" hx-swap="outerHTML" hx-push-url="true" aria-current="{{ 'true' if filter == 'all' else 'false' }}" data-seg>All</a>
      <a href="/notifications?filter=unread" hx-get="/notifications?filter=unread" hx-target="#notification-results" hx-swap="outerHTML" hx-push-url="true" aria-current="{{ 'true' if filter == 'unread' else 'false' }}" data-seg>Unread</a>
    </div>
    <button class="btn btn-ghost" type="button" hx-post="/notifications/read-all" hx-target="#notification-results" hx-swap="outerHTML">{{ icon('check') }}<span>Mark all read</span></button>
  </div>
</header>
{% include "partials/notifications/results.njk" %}
{% endblock %}
