{% extends "layouts/app.njk" %}
{% block title %}Settings{% endblock %}
{% block page %}settings{% endblock %}
{% block crumbs %}<strong>Settings</strong>{% endblock %}
{% block content %}
<header class="page-head"><div><span class="eyebrow">Administration</span><h1 data-split>System settings</h1><p>Persisted in PostgreSQL, served through a Redis read-through cache that is invalidated on save.</p></div></header>
<div class="split">
  {% include "partials/settings-form.njk" %}
  <section class="card glass" data-reveal="card">
    <div class="card-head"><h2>Where data lives</h2></div>
    <div class="kv"><span>Users, requests, products, audit</span><strong>PostgreSQL</strong></div>
    <div class="kv"><span>Sessions & flash messages</span><strong>Redis (TTL)</strong></div>
    <div class="kv"><span>Event distribution</span><strong>Redis Pub/Sub</strong></div>
    <div class="kv"><span>Rate-limit counters</span><strong>Redis (INCR + EXPIRE)</strong></div>
    <div class="kv"><span>Categories, settings cache</span><strong>Redis (read-through)</strong></div>
    <div class="kv"><span>Live connections</span><strong>Redis sorted set</strong></div>
  </section>
</div>
{% endblock %}
