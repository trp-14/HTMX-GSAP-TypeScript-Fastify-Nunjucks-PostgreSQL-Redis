{#- Generated product illustration (used when no photo is uploaded). Shapes per category "art" kind,
    tinted with the category hue — the same visual language as the design reference. -#}
{% macro productArt(art, hue, uid) %}
{%- set k = 'pa' + (uid | replace('-', '')) -%}
{%- set B = 'url(#' + k + 'b)' -%}{%- set S = 'url(#' + k + 's)' -%}
<svg viewBox="0 0 200 150" aria-hidden="true" data-product-art>
  <defs>
    <linearGradient id="{{ k }}b" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="hsl({{ hue }} 45% 82%)"/><stop offset=".5" stop-color="hsl({{ hue }} 35% 58%)"/><stop offset="1" stop-color="hsl({{ hue }} 55% 28%)"/></linearGradient>
    <linearGradient id="{{ k }}s" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="hsl({{ hue }} 85% 18%)"/><stop offset=".6" stop-color="hsl({{ (hue + 40) % 360 }} 85% 45%)"/><stop offset="1" stop-color="hsl({{ (hue + 80) % 360 }} 90% 70%)"/></linearGradient>
    <radialGradient id="{{ k }}g"><stop offset="0" stop-color="hsl({{ hue }} 90% 65%)" stop-opacity=".55"/><stop offset="1" stop-color="hsl({{ hue }} 90% 65%)" stop-opacity="0"/></radialGradient>
  </defs>
  <ellipse cx="100" cy="140" rx="62" ry="8" fill="url(#{{ k }}g)"/>
  {% if art == 'laptop' %}
    <rect x="40" y="18" width="120" height="82" rx="7" fill="{{ B }}"/><rect x="45" y="23" width="110" height="72" rx="3" fill="{{ S }}"/><path d="M26 102h148l-10 14H36Z" fill="{{ B }}"/><rect x="86" y="102" width="28" height="3" rx="1.5" fill="#000" opacity=".3"/><path d="M50 28h34L54 80Z" fill="#fff" opacity=".12"/>
  {% elif art == 'monitor' %}
    <rect x="30" y="14" width="140" height="88" rx="8" fill="{{ B }}"/><rect x="36" y="20" width="128" height="76" rx="4" fill="{{ S }}"/><rect x="92" y="102" width="16" height="20" fill="{{ B }}"/><rect x="66" y="120" width="68" height="8" rx="4" fill="{{ B }}"/><path d="M42 26h40L46 84Z" fill="#fff" opacity=".12"/>
  {% elif art == 'phone' %}
    <rect x="68" y="6" width="64" height="128" rx="15" fill="{{ B }}"/><rect x="72" y="10" width="56" height="120" rx="12" fill="{{ S }}"/><rect x="89" y="15" width="22" height="6" rx="3" fill="#02040c"/><path d="M76 16h20L78 76Z" fill="#fff" opacity=".14"/>
  {% elif art == 'headset' %}
    <path d="M56 90C56 26 144 26 144 90" fill="none" stroke="{{ B }}" stroke-width="11" stroke-linecap="round"/><rect x="40" y="78" width="32" height="48" rx="14" fill="{{ B }}"/><rect x="128" y="78" width="32" height="48" rx="14" fill="{{ B }}"/><rect x="66" y="84" width="9" height="36" rx="4.5" fill="{{ S }}"/><rect x="125" y="84" width="9" height="36" rx="4.5" fill="{{ S }}"/><path d="M48 118q10 14 34 10" fill="none" stroke="{{ B }}" stroke-width="4" stroke-linecap="round"/>
  {% elif art == 'router' %}
    <rect x="34" y="70" width="132" height="44" rx="12" fill="{{ B }}"/><rect x="44" y="84" width="112" height="16" rx="8" fill="{{ S }}"/>{% for i in range(5) %}<circle cx="{{ 60 + i * 20 }}" cy="92" r="3" fill="hsl({{ hue }} 90% 75%)"/>{% endfor %}<rect x="56" y="20" width="7" height="52" rx="3.5" fill="{{ B }}"/><rect x="137" y="20" width="7" height="52" rx="3.5" fill="{{ B }}"/>
  {% elif art == 'chair' %}
    <rect x="62" y="12" width="76" height="70" rx="22" fill="{{ B }}"/><rect x="70" y="20" width="60" height="54" rx="16" fill="{{ S }}"/><rect x="54" y="80" width="92" height="18" rx="9" fill="{{ B }}"/><rect x="96" y="98" width="8" height="22" fill="{{ B }}"/><path d="M64 128l36-8 36 8" fill="none" stroke="{{ B }}" stroke-width="7" stroke-linecap="round"/>
  {% elif art == 'desk' %}
    <rect x="22" y="48" width="156" height="14" rx="5" fill="{{ B }}"/><rect x="30" y="62" width="10" height="64" rx="3" fill="{{ B }}"/><rect x="160" y="62" width="10" height="64" rx="3" fill="{{ B }}"/><rect x="104" y="62" width="50" height="40" rx="6" fill="{{ S }}"/><rect x="118" y="78" width="22" height="4" rx="2" fill="#fff" opacity=".5"/><rect x="60" y="20" width="44" height="28" rx="4" fill="{{ S }}"/>
  {% elif art == 'printer' %}
    <rect x="52" y="14" width="96" height="40" rx="4" fill="#f4f1ea"/><rect x="34" y="48" width="132" height="58" rx="14" fill="{{ B }}"/><rect x="52" y="92" width="96" height="40" rx="4" fill="#f4f1ea"/><rect x="62" y="104" width="60" height="4" rx="2" fill="{{ S }}"/><rect x="62" y="114" width="44" height="4" rx="2" fill="{{ S }}"/><circle cx="146" cy="64" r="4" fill="hsl({{ hue }} 90% 70%)"/>
  {% elif art == 'helmet' %}
    <path d="M40 98a60 60 0 0 1 120 0Z" fill="{{ B }}"/><path d="M92 38h16v60H92Z" fill="{{ S }}" opacity=".8"/><rect x="28" y="96" width="144" height="14" rx="7" fill="{{ B }}"/><path d="M60 60a44 44 0 0 1 30-20" fill="none" stroke="#fff" stroke-opacity=".35" stroke-width="5" stroke-linecap="round"/>
  {% elif art == 'paper' %}
    <rect x="58" y="24" width="84" height="108" rx="6" fill="#f4f1ea" transform="rotate(-6 100 78)"/><rect x="62" y="18" width="84" height="108" rx="6" fill="#fffdf7"/><rect x="74" y="36" width="60" height="5" rx="2.5" fill="{{ S }}"/><rect x="74" y="50" width="48" height="4" rx="2" fill="{{ B }}"/><rect x="74" y="62" width="54" height="4" rx="2" fill="{{ B }}"/><rect x="74" y="74" width="40" height="4" rx="2" fill="{{ B }}"/><circle cx="124" cy="106" r="10" fill="{{ S }}"/>
  {% elif art == 'keyboard' %}
    <rect x="22" y="56" width="156" height="58" rx="12" fill="{{ B }}"/>{% for row in range(3) %}{% for col in range(10) %}<rect x="{{ 32 + col * 14 }}" y="{{ 64 + row * 13 }}" width="10" height="9" rx="2" fill="{{ S }}"/>{% endfor %}{% endfor %}<rect x="62" y="103" width="76" height="6" rx="3" fill="{{ S }}"/>
  {% elif art == 'license' %}
    <rect x="38" y="26" width="124" height="88" rx="14" fill="{{ B }}"/><rect x="46" y="34" width="108" height="72" rx="9" fill="{{ S }}"/><circle cx="76" cy="66" r="14" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width="4"/><path d="m70 66 5 5 8-9" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/><rect x="98" y="56" width="44" height="5" rx="2.5" fill="#fff" opacity=".6"/><rect x="98" y="68" width="32" height="5" rx="2.5" fill="#fff" opacity=".4"/>
  {% else %}
    <path d="M100 22 158 50v52l-58 28-58-28V50Z" fill="{{ B }}"/><path d="M100 78 158 50v52l-58 28Z" fill="{{ S }}"/><path d="M42 50l58 28v52" fill="none" stroke="#fff" stroke-opacity=".25" stroke-width="2"/><path d="m71 36 58 28v20" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="5"/>
  {% endif %}
</svg>
{% endmacro %}

{% macro productVisual(p) %}
{% if p.imageKey %}<img src="/products/{{ p.id }}/image?v={{ p.updatedAt | iso }}" alt="{{ p.name }}" loading="lazy" data-product-art>{% else %}{{ productArt(p.art, p.hue, p.id) }}{% endif %}
{% endmacro %}
