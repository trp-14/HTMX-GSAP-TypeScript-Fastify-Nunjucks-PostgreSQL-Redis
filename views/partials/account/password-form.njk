{% from "components/forms.njk" import input, formError %}
{% from "components/ui.njk" import alert %}
<section class="card glass" id="password-card" data-reveal="card">
  <div class="card-head"><h2>Password</h2></div>
  <form class="grid" style="gap:14px" hx-put="/account/password" hx-target="#password-card" hx-swap="outerHTML" novalidate>
    {% if done %}{{ alert('Password updated', 'Every other session was signed out.', 'good', 'check') }}{% endif %}
    {{ formError(errors) }}
    {{ input('currentPassword', 'Current password', '', 'password', errors, required=true, attrs='autocomplete="current-password"') }}
    {{ input('newPassword', 'New password', '', 'password', errors, hint='At least 10 characters, mixing letters with numbers or symbols.', required=true, attrs='autocomplete="new-password"') }}
    {{ input('confirmPassword', 'Confirm new password', '', 'password', errors, required=true, attrs='autocomplete="new-password"') }}
    <div class="form-actions"><button class="btn btn-primary" type="submit">Change password<span class="spinner" aria-hidden="true"></span></button></div>
  </form>
</section>
